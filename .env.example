# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google OAuth Merchant Login (see backend/auth.py)
# OAuth 2.0 Client credentials from Google Cloud Console (Credentials -> OAuth client ID, Web application)
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."
# Public base URL of THIS backend — used to build the redirect_uri
# (must exactly match a redirect URI registered in Google Cloud Console)
APP_BASE_URL="http://localhost:8000"
# Frontend base URL — served by the backend itself (/login, /dashboard pages);
# redirect target after login (dashboard) and logout
FRONTEND_URL="http://localhost:8000"

# Session signing — secret used to sign/verify the HS256 session JWT
# (recoverai_session httpOnly cookie, 24h expiry)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="..."

# Execution Policy (see backend/EXECUTION_POLICY.md)
# Max real (Razorpay) payment-link sends the execution layer may perform per run — volume safety cap
MAX_REAL_RECOVERY_ACTIONS="10"
# Transactions above this amount (paise) are never auto-actioned — 500000 paise = ₹5,000; higher amounts escalate to human review
MAX_AUTOMATED_AMOUNT_PAISE="500000"
# Recovery-attempt hard cap — transactions at/above this are hard-stopped (matches the detector's EXHAUSTED_ATTEMPTS rule)
MAX_ATTEMPTS="3"
# Master switch for live execution — becomes True ONLY when set to exactly "true"; any other value ("1", "yes", empty, unset) keeps it False
LIVE_EXECUTION_ENABLED="false"

# OpenRouter LLM Configuration
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Default cheap/free model supporting structured JSON (e.g. google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
