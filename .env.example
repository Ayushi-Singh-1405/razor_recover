# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Execution Policy (see backend/EXECUTION_POLICY.md)
# Max real (Razorpay) payment-link sends the execution layer may perform per run — volume safety cap
MAX_REAL_RECOVERY_ACTIONS="10"
# Transactions above this amount (paise) are never auto-actioned — 500000 paise = ₹5,000; higher amounts escalate to human review
MAX_AUTOMATED_AMOUNT_PAISE="500000"
# Recovery-attempt hard cap — transactions at/above this are hard-stopped (matches the detector's EXHAUSTED_ATTEMPTS rule)
MAX_ATTEMPTS="3"
# Master switch for live execution — becomes True ONLY when set to exactly "true"; any other value ("1", "yes", empty, unset) keeps it False
LIVE_EXECUTION_ENABLED="false"

# OpenRouter LLM Configuration
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Default cheap/free model supporting structured JSON (e.g. google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
